# Dépendances Node.js (Protection SCA & allègement du dépôt)
node_modules/

# Répertoire de compilation TypeScript
dist/

# Fichiers de secrets et variables d'environnement (Sécurité ANSSI / RGPD / CWE-200 / CWE-540)
.env
.env.local
.env.*.local

# Fichiers de logs applicatifs (Protection des données personnelles RGPD)
logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers et dossiers du système d'exploitation
.DS_Store
Thumbs.db

