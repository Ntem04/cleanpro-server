# ─── Initialisation / Seed Administrateur (Optionnel) ───────────────────────
# Mot de passe du premier compte Super Administrateur créé lors du seed
# Si non renseigné en dev, un mot de passe aléatoire temporaire est généré au seed
# En production, cette variable est OBLIGATOIRE si le seed est exécuté
SEED_ADMIN_EMAIL=admin@cleanpro.cm
SEED_ADMIN_PASSWORD=Definir_Un_Mot_De_Passe_Fort_12_Caracteres_Min!

# ─── Configuration Serveur CleanPro ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Origines autorisées par CORS (Support Vite 5173 et SSR 3000)
CLIENT_URL=http://localhost:5173

# URL de connexion à la base de données PostgreSQL pour Prisma
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/cleanpro_db?schema=public
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@localhost:5432/cleanpro_db?schema=public

# Clé secrète de signature des jetons JWT — MINIMUM 64 caractères aléatoires (OWASP ASVS §2.10.4 / ANSSI)
# ⚠️  Valeur obligatoire — l'application REFUSE de démarrer sans un secret suffisamment fort.
# Pour générer un secret conforme :
#   node -e "const c=require('crypto');console.log(c.randomBytes(64).toString('base64'))"
# ⚠️  Ne JAMAIS utiliser une valeur fixe, mémorisable ou issue d'un exemple de documentation.
# ⚠️  Rotation : changer ce secret invalide toutes les sessions actives (tous les JWT signés précédemment).
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_MINIMUM_64_CARACTERES

# ─── Configuration Gmail Nodemailer (Sécurisé par Mot de Passe d'Application) ──
# 1. Activez la validation en 2 étapes sur votre compte Google.
# 2. Allez sur https://myaccount.google.com/apppasswords
# 3. Générez un mot de passe d'application (16 caractères sans espaces)
GMAIL_USER=votre_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=votre_email_de_reception@gmail.com

# ─── Configuration SMTP Alternative (Optionnel) ──────────────────────────────
SMTP_HOST=smtp.cleanpro.cm
SMTP_PORT=587
SMTP_USER=contact@cleanpro.cm
SMTP_PASS=mot_de_passe_smtp_securise
SUPER_ADMIN_ALERT_EMAIL=admin@cleanpro.cm

# ─── Politique de Rétention des Journaux (en jours) ─────────────────────────
LOG_RETENTION_DAYS=90
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
